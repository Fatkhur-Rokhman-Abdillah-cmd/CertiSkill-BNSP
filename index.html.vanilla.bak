              </div>
            </div>
          </div>

          <!-- Profile Right Area: Settings Tabs & Forms -->
          <div class="profile-card profile-content">

            <div class="profile-nav-tabs" role="tablist">
              <button type="button" role="tab" class="prof-tab-btn active" aria-selected="true"
                data-prof-tab="data-diri">
                Data Diri
              </button>
              <button type="button" role="tab" class="prof-tab-btn" aria-selected="false" data-prof-tab="pendidikan">
                Pendidikan & Portofolio
              </button>
              <button type="button" role="tab" class="prof-tab-btn" aria-selected="false" data-prof-tab="keamanan">
                Keamanan & Akun
              </button>
            </div>

            <!-- Tab Pane 1: Data Diri -->
            <form id="profile-personal-form" class="profile-form-pane active" novalidate>
              <h3 class="form-section-title">Data Identitas Asesi Sesuai KTP / Paspor</h3>

              <div class="form-row-2">
                <div class="form-group">
                  <label for="prof-nama" class="form-label">Nama Lengkap & Gelar (Sesuai Ijazah)</label>
                  <input type="text" id="prof-nama" class="form-input" value="Raden Bagus Prakoso, S.Kom" required>
                </div>
                <div class="form-group">
                  <label for="prof-nik" class="form-label">Nomor Induk Kependudukan (NIK)</label>
                  <input type="text" id="prof-nik" class="form-input font-mono" value="3273201402980004" required>
                </div>
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label for="prof-email" class="form-label">Alamat Surat Elektronik (Email)</label>
                  <input type="email" id="prof-email" class="form-input font-mono" value="bagus.prakoso@alumni.ac.id"
                    required>
                </div>
                <div class="form-group">
                  <label for="prof-phone" class="form-label">Nomor Kontak WhatsApp / Telepon</label>
                  <input type="tel" id="prof-phone" class="form-input font-mono" value="+62 812-9844-3200" required>
                </div>
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label for="prof-ttl" class="form-label">Tempat & Tanggal Lahir</label>
                  <input type="text" id="prof-ttl" class="form-input" value="Bandung, 14 Februari 1998">
                </div>
                <div class="form-group">
                  <label for="prof-gender" class="form-label">Jenis Kelamin</label>
                  <select id="prof-gender" class="form-input">
                    <option value="L" selected>Laki-laki</option>
                    <option value="P">Perempuan</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="prof-alamat" class="form-label">Alamat Domisili Kependudukan</label>
                <textarea id="prof-alamat" class="form-input"
                  rows="2">Jl. Dago Asri Raya No. 18, Coblong, Kota Bandung, Jawa Barat 40135</textarea>
              </div>

              <div class="form-action-row">
                <button type="submit" class="btn btn-primary">
                  <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">save</span>
                  Simpan Perubahan Identitas
                </button>
              </div>
            </form>

            <!-- Tab Pane 2: Pendidikan & Portofolio -->
            <form id="profile-edu-form" class="profile-form-pane" novalidate>
              <h3 class="form-section-title">Riwayat Pendidikan Formal & Instansi Asal</h3>

              <div class="form-row-2">
                <div class="form-group">
                  <label for="prof-pendidikan" class="form-label">Pendidikan Terakhir</label>
                  <select id="prof-pendidikan" class="form-input">
                    <option value="S1" selected>Strata 1 (S1 / D4)</option>
                    <option value="S2">Strata 2 (S2)</option>
                    <option value="D3">Diploma 3 (D3)</option>
                    <option value="SMK">SMK / SMA Sederajat</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="prof-kampus" class="form-label">Nama Perguruan Tinggi / Sekolah</label>
                  <input type="text" id="prof-kampus" class="form-input" value="Institut Teknologi Bandung (ITB)">
                </div>
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label for="prof-prodi" class="form-label">Program Studi / Jurusan</label>
                  <input type="text" id="prof-prodi" class="form-input" value="Teknik Informatika">
                </div>
                <div class="form-group">
                  <label for="prof-pekerjaan" class="form-label">Instansi / Perusahaan Tempat Kerja Saat Ini</label>
                  <input type="text" id="prof-pekerjaan" class="form-input" value="PT Solusi Awan Nusantara">
                </div>
              </div>

              <h3 class="form-section-title mt-4">Dokumen Bukti Portofolio (Persyaratan APL-01)</h3>
              <div class="portfolio-files-box">
                <div class="p-file-item">
                  <span class="material-symbols-outlined file-ico" aria-hidden="true">picture_as_pdf</span>
                  <div class="file-info">
                    <strong>Ijazah-S1-Informatika-Legalisir.pdf</strong>
                    <span class="font-mono text-xs text-muted">2.4 MB - Terverifikasi oleh Tim Asesmen</span>
                  </div>
                  <span class="status-badge badge-success">Valid</span>
                </div>
                <div class="p-file-item">
                  <span class="material-symbols-outlined file-ico" aria-hidden="true">picture_as_pdf</span>
                  <div class="file-info">
                    <strong>Surat-Keterangan-Pengalaman-Kerja-3Tahun.pdf</strong>
                    <span class="font-mono text-xs text-muted">1.1 MB - Ditandatangani Pimpinan Perusahaan</span>
                  </div>
                  <span class="status-badge badge-success">Valid</span>
                </div>
              </div>

              <div class="form-action-row">
                <button type="submit" class="btn btn-primary">
                  <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">upload_file</span>
                  Perbarui Portofolio & Pendidikan
                </button>
              </div>
            </form>

            <!-- Tab Pane 3: Keamanan & Akun -->
            <form id="profile-security-form" class="profile-form-pane" novalidate>
              <h3 class="form-section-title">Pengaturan Sandi & Keamanan Masuk</h3>

              <div class="form-group">
                <label for="pass-current" class="form-label">Kata Sandi Saat Ini</label>
                <input type="password" id="pass-current" class="form-input font-mono"
                  placeholder="Masukkan sandi saat ini">
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label for="pass-new" class="form-label">Kata Sandi Baru</label>
                  <input type="password" id="pass-new" class="form-input font-mono"
                    placeholder="Minimal 8 karakter kombinasi">
                </div>
                <div class="form-group">
                  <label for="pass-confirm" class="form-label">Konfirmasi Kata Sandi Baru</label>
                  <input type="password" id="pass-confirm" class="form-input font-mono"
                    placeholder="Ulangi kata sandi baru">
                </div>
              </div>

              <h3 class="form-section-title mt-4">Autentikasi Dua Langkah (2FA)</h3>
              <div class="security-toggle-card">
                <div class="sec-left">
                  <span class="material-symbols-outlined text-primary" aria-hidden="true">security</span>
                  <div>
                    <strong>Verifikasi Kode OTP WhatsApp / Email</strong>
                    <p class="text-sm text-muted">Meminta kode acak 6 angka setiap kali mengakses unduhan sertifikat
                      asli.</p>
                  </div>
                </div>
                <label class="switch-toggle" for="switch-2fa">
                  <input type="checkbox" id="switch-2fa" checked>
                  <span class="toggle-slider"></span>
                  <span class="sr-only">Aktifkan Autentikasi Dua Langkah</span>
                </label>
              </div>

              <div class="form-action-row">
                <button type="submit" class="btn btn-primary">
                  <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">lock_reset</span>
                  Simpan Pengaturan Keamanan
                </button>
              </div>
            </form>

          </div>

        </div>
      </div>
    </section>

  </main>

  <!-- Interactive Modal: Certificate Detailed Inspector -->
  <div id="cert-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-cert-title"
    aria-hidden="true">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <span class="material-symbols-outlined modal-header-icon" aria-hidden="true">verified</span>
          <h2 id="modal-cert-title" class="modal-title">Lembar Rincian Sertifikat Resmi BNSP</h2>
        </div>
        <button type="button" id="modal-close-btn" class="modal-close-btn btn-icon"
          aria-label="Tutup jendela rincian sertifikat">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>

      <div class="modal-body" id="modal-cert-content">
        <!-- Injected dynamically -->
      </div>

      <div class="modal-footer">
        <button type="button" id="modal-copy-link-btn" class="btn btn-outline">
          <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">link</span>
          Salin Tautan Verifikasi
        </button>
        <button type="button" id="modal-download-sim-btn" class="btn btn-primary">
          <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">download</span>
          Unduh Dokumen PDF
        </button>
      </div>
    </div>
  </div>

  <!-- Interactive Modal: Registration for BNSP Assessment -->
  <div id="register-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-reg-title"
    aria-hidden="true">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <span class="material-symbols-outlined modal-header-icon" aria-hidden="true">how_to_reg</span>
          <h2 id="modal-reg-title" class="modal-title">Formulir Pendaftaran Uji Asesmen</h2>
        </div>
        <button type="button" id="reg-modal-close-btn" class="modal-close-btn btn-icon"
          aria-label="Tutup formulir pendaftaran">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>

      <div class="modal-body">
        <form id="scheme-register-form">
          <div class="form-group">
            <label class="form-label">Skema Sertifikasi Pilihan</label>
            <input type="text" id="reg-scheme-display" class="form-input font-bold" readonly>
          </div>
          <div class="form-group">
            <label for="reg-tuk-select" class="form-label">Pilih Tempat Uji Kompetensi (TUK)</label>
            <select id="reg-tuk-select" class="form-input" required>
              <option value="TUK Cyber Jakarta">TUK Mandiri Kampus Cyber Jakarta</option>
              <option value="TUK Telkom ITB Bandung">TUK Mandiri Telkom ITB Bandung</option>
              <option value="TUK Sewaktu Kemkomdigi">TUK Sewaktu Kemkomdigi Jakarta Pusat</option>
              <option value="TUK Virtual Daring">TUK Virtual Daring (Asesmen Jarak Jauh)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="reg-date-select" class="form-label">Pilih Periode Tanggal Asesmen</label>
            <select id="reg-date-select" class="form-input" required>
              <option value="28 Maret 2026">28 Maret 2026 (Sesi Pagi 08.30 WIB)</option>
              <option value="05 April 2026">05 April 2026 (Sesi Pagi 09.00 WIB)</option>
              <option value="18 April 2026">18 April 2026 (Sesi Siang 13.00 WIB)</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Konfirmasi Data Pemohon</label>
            <div class="confirm-box font-mono text-sm">
              <div>Asesi : Raden Bagus Prakoso, S.Kom</div>
              <div>NIK : 327320******0004</div>
              <div>Status: Portofolio APL-01 Terunggah</div>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-block">
            <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">check</span>
            Kirim Permohonan Asesmen BNSP
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Notification Toast for feedback actions -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

