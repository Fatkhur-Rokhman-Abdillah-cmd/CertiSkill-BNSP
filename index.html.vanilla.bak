<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SertifikaNet BNSP - Portal Uji & Sertifikasi Kompetensi Digital Nasional</title>
  <title>CertiSkill BNSP - Portal Uji &amp; Sertifikasi Kompetensi Digital Nasional</title>

  <!-- Google Fonts: Poppins (Heading & Brand), Plus Jakarta Sans (Body), Roboto Mono (Hash/Nomor Registrasi BNSP) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Poppins:wght@500;600;700;800&family=Roboto+Mono:wght@400;500;600&display=swap"
    rel="stylesheet">

  <!-- Google Material Symbols Outlined (Pure Google Icons) -->
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">

  <link rel="stylesheet" href="styles.css">
</head>

<body class="theme-light">
  <!-- Accessibility Skip Link -->
  <a href="#main-app" class="skip-link">Lewati ke konten aplikasi</a>

  <!-- Top Institutional Bar -->
  <aside class="institutional-bar" aria-label="Informasi Afiliasi Resmi">
    <div class="container institutional-inner">
      <div class="inst-left">
        <span class="material-symbols-outlined inst-icon" aria-hidden="true">verified</span>
        <span>Lembaga Sertifikasi Profesi (LSP) Terlisensi Badan Nasional Sertifikasi Profesi (BNSP)</span>
      </div>
      <div class="inst-right font-mono">
        <span>Lisensi No: KEP.0418/BNSP/III/2024</span>
      </div>
    </div>
  </aside>

  <!-- Site Navigation Header -->
  <header class="site-header" id="site-header">
    <div class="header-container">
      <a href="#tab-beranda" class="brand-logo" data-target-tab="beranda" aria-label="SertifikaNet BNSP Beranda">
        <div class="brand-badge-icon">
          <span class="material-symbols-outlined" aria-hidden="true">workspace_premium</span>
          <a href="#tab-beranda" class="brand-logo" data-target-tab="beranda" aria-label="CertiSkill BNSP Beranda">
            <div class="brand-badge-icon" aria-hidden="true">
              <span class="brand-logo-monogram">CS</span>
            </div>
            <div class="brand-text">
              <span class="brand-name">Sertifika<span class="brand-accent">Net</span></span>
              <span class="brand-name">Certi<span class="brand-accent">Skill</span></span>
              <span class="brand-sub">PORTAL UJI KOMPETENSI BNSP</span>
            </div>
          </a>

          <!-- Primary Application Navigation (Tabs) -->
          <nav class="main-tab-nav" aria-label="Navigasi Utama Aplikasi">
            <ul class="nav-tab-list" role="tablist">
              <li role="presentation">
                <button type="button" role="tab" id="nav-btn-beranda" class="nav-tab-btn nav-pill-btn active"
                  aria-selected="true" aria-controls="view-beranda" data-tab="beranda"
                  aria-label="Tab Beranda: Portal Uji Kompetensi BNSP">
                  <div class="user-avatar-initial nav-avatar-icon" aria-hidden="true">
                    <span class="material-symbols-outlined">home</span>
                  </div>
                  <div class="user-pill-info">
                    <span class="user-pill-name">Beranda</span>
                    <span class="user-pill-role font-mono">Portal BNSP</span>
                  </div>
                </button>
              </li>
              <li role="presentation">
                <button type="button" role="tab" id="nav-btn-katalog" class="nav-tab-btn nav-pill-btn"
                  aria-selected="false" aria-controls="view-katalog" data-tab="katalog"
                  aria-label="Tab Katalog Skema Sertifikasi BNSP">
                  <div class="user-avatar-initial nav-avatar-icon" aria-hidden="true">
                    <span class="material-symbols-outlined">menu_book</span>
                  </div>
                  <div class="user-pill-info">
                    <span class="user-pill-name">Katalog</span>
                    <span class="user-pill-role font-mono">Skema SKKNI</span>
                  </div>
                </button>
              </li>
              <li role="presentation">
                <button type="button" role="tab" id="nav-btn-jadwal" class="nav-tab-btn nav-pill-btn"
                  aria-selected="false" aria-controls="view-jadwal" data-tab="jadwal"
                  aria-label="Tab Jadwal Asesmen dan Unduhan Materi APL">
                  <div class="user-avatar-initial nav-avatar-icon" aria-hidden="true">
                    <span class="material-symbols-outlined">calendar_month</span>
                  </div>
                  <div class="user-pill-info">
                    <span class="user-pill-name">Jadwal & Materi</span>
                    <span class="user-pill-role font-mono">TUK Resmi</span>
                  </div>
                </button>
              </li>
              <li role="presentation">
                <button type="button" role="tab" id="nav-btn-ujian" class="nav-tab-btn nav-pill-btn"
                  aria-selected="false" aria-controls="view-ujian" data-tab="ujian"
                  aria-label="Tab Ruang Ujian Online CBT Berproktor Ketat">
                  <div class="user-avatar-initial nav-avatar-icon nav-icon-warning" aria-hidden="true">
                    <span class="material-symbols-outlined text-warning">quiz</span>
                  </div>
                  <div class="user-pill-info">
                    <span class="user-pill-name">Ujian Online</span>
                    <span class="user-pill-role font-mono text-warning">CBT Proktor</span>
                  </div>
                </button>
              </li>
              <li role="presentation">
                <button type="button" role="tab" id="nav-btn-sertifikasi" class="nav-tab-btn nav-pill-btn"
                  aria-selected="false" aria-controls="view-sertifikasi" data-tab="sertifikasi"
                  aria-label="Tab Daftar Sertifikat Kompetensi BNSP">
                  <div class="user-avatar-initial nav-avatar-icon" aria-hidden="true">
                    <span class="material-symbols-outlined">military_tech</span>
                  </div>
                  <div class="user-pill-info">
                    <span class="user-pill-name">Sertifikasi</span>
                    <span class="user-pill-role font-mono"><span id="earned-cert-count">2</span> Sertifikat</span>
                  </div>
                </button>
              </li>
              <li role="presentation">
                <button type="button" role="tab" id="nav-btn-profil" class="nav-tab-btn nav-pill-btn"
                  aria-selected="false" aria-controls="view-profil" data-tab="profil"
                  aria-label="Tab Pengaturan Profil Asesi">
                  <div class="user-avatar-initial nav-avatar-icon" aria-hidden="true">
                    <span class="material-symbols-outlined">manage_accounts</span>
                  </div>
                  <div class="user-pill-info">
                    <span class="user-pill-name">Profile</span>
                    <span class="user-pill-role font-mono">Pengaturan</span>
                  </div>
                </button>
              </li>
            </ul>
          </nav>

          <!-- Header Utilities -->
          <div class="header-actions">
            <!-- Theme Toggle -->
            <button type="button" id="theme-toggle" class="btn-icon theme-toggle-btn" aria-label="Beralih ke mode gelap"
              title="Ubah tampilan tema">
              <span class="material-symbols-outlined" aria-hidden="true">dark_mode</span>
            </button>

            <!-- Asesi Quick Account Mini Profile -->
            <div class="user-pill-btn" id="header-user-btn" role="button" tabindex="0"
              aria-label="Buka profil asesi: Raden Bagus Prakoso">
              <div class="user-avatar-initial" aria-hidden="true">RB</div>
              <div class="user-pill-info">
                <span class="user-pill-name">Raden Bagus P.</span>
                <span class="user-pill-role font-mono">Asesi Terverifikasi</span>
              </div>
            </div>

            <!-- Mobile Drawer Toggle -->
            <button type="button" id="mobile-menu-btn" class="mobile-menu-btn btn-icon" aria-expanded="false"
              aria-controls="mobile-nav-drawer" aria-label="Buka menu navigasi mobile">
              <span class="material-symbols-outlined" aria-hidden="true">menu</span>
            </button>
          </div>
        </div>

        <!-- Mobile Navigation Drawer -->
        <div id="mobile-nav-drawer" class="mobile-drawer" aria-hidden="true">
          <div class="mobile-user-card">
            <div class="user-avatar-initial lg">RB</div>
            <div>
              <strong class="mobile-user-name">Raden Bagus Prakoso, S.Kom</strong>
              <span class="mobile-user-id font-mono">ID Asesi: BNSP-ID-2026-0912</span>
            </div>
          </div>
          <nav aria-label="Navigasi Menu Mobile">
            <ul class="mobile-nav-list">
              <li>
                <button type="button" class="mobile-nav-btn active" data-tab="beranda">
                  <span class="material-symbols-outlined" aria-hidden="true">home</span>
                  Beranda Portal
                </button>
              </li>
              <li>
                <button type="button" class="mobile-nav-btn" data-tab="katalog">
                  <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                  Katalog Skema Sertifikasi
                </button>
              </li>
              <li>
                <button type="button" class="mobile-nav-btn" data-tab="jadwal">
                  <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                  Jadwal Asesmen & Materi
                </button>
              </li>
              <li>
                <button type="button" class="mobile-nav-btn" data-tab="ujian">
                  <span class="material-symbols-outlined" aria-hidden="true">quiz</span>
                  Ruang Ujian Online (CBT Proktor)
                </button>
              </li>
              <li>
                <button type="button" class="mobile-nav-btn" data-tab="sertifikasi">
                  <span class="material-symbols-outlined" aria-hidden="true">military_tech</span>
                  Sertifikat Saya (2)
                </button>
              </li>
              <li>
                <button type="button" class="mobile-nav-btn" data-tab="profil">
                  <span class="material-symbols-outlined" aria-hidden="true">manage_accounts</span>
                  Pengaturan Profil Asesi
                </button>
              </li>
            </ul>
          </nav>
        </div>
  </header>

  <!-- Main Multi-Tab Application Container -->
  <main id="main-app" class="main-content-wrap">

    <!-- ===================================================================
         TAB 1: BERANDA
         =================================================================== -->
    <section id="view-beranda" class="tab-pane active" role="tabpanel" aria-labelledby="nav-btn-beranda">

      <!-- Asesi Dashboard Greeting -->
      <div class="dashboard-hero-section">
        <div class="container">
          <div class="dashboard-hero-card">
            <div class="hero-left">
              <div class="section-tag">
                <span class="material-symbols-outlined tag-icon" aria-hidden="true">shield</span>
                Sertifikasi Kompetensi Kerja Nasional Indonesia
              </div>
              <h1 class="hero-title">Selamat Datang di Portal Asesmen SertifikaNet</h1>
              <h1 class="hero-title">Selamat Datang di Portal Asesmen CertiSkill</h1>
              <p class="hero-subtitle">
                Akses resmi peserta uji sertifikasi kompetensi berstandar BNSP. Ikuti ujian online CBT berproktor ketat,
                pantau jadwal asesmen di Tempat Uji Kompetensi (TUK), unduh materi pra-asesmen APL-01/02, dan kelola
                dokumen sertifikat resmi Anda.
              </p>
              <div class="hero-actions">
                <button type="button" class="btn btn-primary" id="btn-hero-start-exam" data-tab="ujian">
                  <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">quiz</span>
                  Masuk Ruang Ujian Online CBT
                </button>
                <button type="button" class="btn btn-outline" id="btn-jump-katalog" data-tab="katalog">
                  <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">menu_book</span>
                  Katalog Skema SKKNI
                </button>
              </div>
            </div>

            <!-- Stats Overview Cards -->
            <div class="hero-stats-panel">
              <div class="stat-mini-card">
                <div class="stat-icon-wrap bg-blue">
                  <span class="material-symbols-outlined" aria-hidden="true">workspace_premium</span>
                </div>
                <div>
                  <span class="stat-val font-mono">2</span>
                  <span class="stat-lbl">Sertifikat BNSP Aktif</span>
                </div>
              </div>

              <div class="stat-mini-card">
                <div class="stat-icon-wrap bg-emerald">
                  <span class="material-symbols-outlined" aria-hidden="true">event_available</span>
                </div>
                <div>
                  <span class="stat-val font-mono">1</span>
                  <span class="stat-lbl">Asesmen Terjadwal</span>
                </div>
              </div>

              <div class="stat-mini-card">
                <div class="stat-icon-wrap bg-indigo">
                  <span class="material-symbols-outlined" aria-hidden="true">videocam</span>
                </div>
                <div>
                  <span class="stat-val font-mono">CBT</span>
                  <span class="stat-lbl">Ujian Online Berproktor</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Interactive Verification & Active Schedule Reminder -->
      <div class="container section-spacer">
        <div class="two-col-dashboard-grid">

          <!-- Upcoming Assessment Alert Box -->
          <div class="card panel-card">
            <div class="card-header">
              <div class="card-header-left">
                <span class="material-symbols-outlined text-primary" aria-hidden="true">event_note</span>
                <h2 class="card-heading">Jadwal Uji Kompetensi Terdekat Anda</h2>
              </div>
              <span class="status-badge badge-warning">Tahap Pra-Asesmen</span>
            </div>

            <div class="assessment-reminder-box">
              <div class="reminder-top">
                <h3 class="reminder-scheme-title">Arsitek Solusi Perangkat Lunak Skala Besar</h3>
                <span class="font-mono text-muted text-xs">Skema: SWE-ARCH-01 (SKKNI Level 7)</span>
              </div>

              <div class="reminder-meta-list">
                <div class="reminder-meta-item">
                  <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
                  <div>
                    <strong>28 Maret 2026</strong>
                    <span>Pukul 08.30 - 15.00 WIB</span>
                  </div>
                </div>
                <div class="reminder-meta-item">
                  <span class="material-symbols-outlined" aria-hidden="true">location_city</span>
                  <div>
                    <strong>TUK Mandiri Kampus Cyber Jakarta</strong>
                    <span>Laboratorium Uji 3, Lantai 2</span>
                  </div>
                </div>
                <div class="reminder-meta-item">
                  <span class="material-symbols-outlined" aria-hidden="true">badge</span>
                  <div>
                    <strong>Asesor Penguji Ditugaskan</strong>
                    <span>Ir. Hendra Gunawan, M.T. (No Reg: MET.000.002811)</span>
                  </div>
                </div>
              </div>

              <div class="reminder-footer">
                <button type="button" class="btn btn-primary btn-sm" id="btn-go-to-exam-reminder" data-tab="ujian">
                  <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">computer</span>
                  Simulasi Ujian Teori CBT
                </button>
                <button type="button" class="btn btn-outline btn-sm" id="btn-view-materi-beranda" data-tab="jadwal">
                  <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">download</span>
                  Unduh Berkas APL
                </button>
              </div>
            </div>
          </div>

          <!-- Direct Verification Tool on Beranda -->
          <div class="card panel-card">
            <div class="card-header">
              <div class="card-header-left">
                <span class="material-symbols-outlined text-primary" aria-hidden="true">qr_code_scanner</span>
                <h2 class="card-heading">Pengecekan Keaslian Sertifikat BNSP</h2>
              </div>
              <span class="status-badge badge-success">Online 24/7</span>
            </div>

            <p class="text-sm text-muted mb-3">
              Verifikasi sertifikat kompetensi berlogo Garuda BNSP menggunakan nomor registrasi resmi atau hash tanda
              tangan kriptografi.
            </p>

            <form id="beranda-verify-form" class="verify-form" novalidate>
              <div class="input-with-action">
                <span class="material-symbols-outlined input-leading-icon" aria-hidden="true">badge</span>
                <input type="text" id="beranda-cert-input" class="form-input font-mono"
                  placeholder="Contoh: CERT-2026-8891" required>
                <button type="submit" class="btn btn-primary verify-submit-btn">
                  <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">search</span>
                  Periksa
                </button>
              </div>

              <div class="quick-samples">
                <span class="quick-samples-label">Coba sampel dokumen:</span>
                <div class="sample-chips">
                  <button type="button" class="sample-chip" data-sample="CERT-2026-8891">CERT-2026-8891 (Siber)</button>
                  <button type="button" class="sample-chip" data-sample="CERT-2025-5519">CERT-2025-5519 (AI)</button>
                  <button type="button" class="sample-chip" data-sample="CERT-2024-4402">CERT-2024-4402
                    (Kedaluwarsa)</button>
                </div>
              </div>
            </form>

            <div id="beranda-result-area" class="verify-result-panel" aria-live="polite">
              <div class="state-container state-initial">
                <span class="material-symbols-outlined state-icon" aria-hidden="true">fingerprint</span>
                <p class="state-message">Masukkan nomor registrasi sertifikat BNSP Anda di atas untuk memeriksa status
                  pengesahan.</p>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- BNSP Certification 5-Stage Workflow Guide -->
      <div class="container section-spacer">
        <div class="section-header text-center">
          <div class="section-tag">
            <span class="material-symbols-outlined tag-icon" aria-hidden="true">flowchart</span>
            SOP Sertifikasi BNSP
          </div>
          <h2 class="section-heading">Tahapan Mengikuti Uji Sertifikasi Kompetensi</h2>
          <p class="section-subheading">
            Proses terstandar nasional dari pendaftaran skema hingga pengesahan dan penerbitan sertifikat digital
            berlogo Garuda.
          </p>
        </div>

        <div class="flow-steps-grid five-cols">
          <div class="flow-step-card">
            <div class="step-badge font-mono">LANGKAH 1</div>
            <div class="step-icon-wrap">
              <span class="material-symbols-outlined" aria-hidden="true">app_registration</span>
            </div>
            <h3 class="step-title">Pilih Skema & APL-01</h3>
            <p class="step-desc">
              Pilih kualifikasi di katalog skema. Asesi melengkapi data pemohon sertifikasi dan mengunggah portofolio
              bukti kerja.
            </p>
          </div>

          <div class="flow-step-card">
            <div class="step-badge font-mono">LANGKAH 2</div>
            <div class="step-icon-wrap">
              <span class="material-symbols-outlined" aria-hidden="true">checklist</span>
            </div>
            <h3 class="step-title">Asesmen Mandiri APL-02</h3>
            <p class="step-desc">
              Asesi meninjau setiap unit kompetensi SKKNI dan menyatakan kesiapan bukti (Bukti Kompetensi / BK) secara
              objektif.
            </p>
          </div>

          <div class="flow-step-card">
            <div class="step-badge font-mono">LANGKAH 3</div>
            <div class="step-icon-wrap">
              <span class="material-symbols-outlined" aria-hidden="true">videocam</span>
            </div>
            <h3 class="step-title">Uji Teori CBT Online</h3>
            <p class="step-desc">
              Ujian berbasis komputer dengan pengawasan kamera langsung dan sistem deteksi perpindahan tab anti
              kecurangan.
            </p>
          </div>

          <div class="flow-step-card">
            <div class="step-badge font-mono">LANGKAH 4</div>
            <div class="step-icon-wrap">
              <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
            </div>
            <h3 class="step-title">Praktik TUK & Pleno</h3>
            <p class="step-desc">
              Asesor merekomendasikan status Kompeten (K). Komite Teknis LSP menggelar rapat pleno penetapan hasil
              sertifikasi.
            </p>
          </div>

          <div class="flow-step-card">
            <div class="step-badge font-mono">LANGKAH 5</div>
            <div class="step-icon-wrap">
              <span class="material-symbols-outlined" aria-hidden="true">verified</span>
            </div>
            <h3 class="step-title">Terbit Sertifikat Garuda</h3>
            <p class="step-desc">
              Sertifikat kompetensi resmi terbit dengan nomor registrasi BNSP nasional dan stempel tanda tangan
              elektronik bersertifikasi.
            </p>
          </div>
        </div>
      </div>

    </section>

    <!-- ===================================================================
         TAB: UJIAN ONLINE (CBT PROKTOR KETAT: DETEKSI KAMERA & PINDAH TAB MAX 3X)
         =================================================================== -->
    <section id="view-ujian" class="tab-pane" role="tabpanel" aria-labelledby="nav-btn-ujian">
      <div class="container section-spacer">

        <!-- View State A: Pre-Exam Integrity Lobby & Camera Check -->
        <div id="exam-lobby-screen" class="exam-screen-block">
          <div class="section-header text-center">
            <div class="section-tag exam-live-tag">
              <span class="material-symbols-outlined tag-icon" aria-hidden="true">security</span>
              Sistem Pengawasan Asesmen Terpusat (CBT Proktor BNSP)
            </div>
            <h1 class="section-heading">Ruang Uji Kompetensi Berproktor Digital</h1>
            <p class="section-subheading">
              Sesi uji teori kompetensi resmi berbasis komputer. Pengawasan ketat diterapkan secara otomatis melalui
              pemantauan kamera video dan pembatasan perpindahan tab browser.
            </p>
          </div>

          <div class="exam-lobby-grid">

            <!-- Left: Integrity Rules & Penalty Info -->
            <div class="card exam-rules-card">
              <div class="card-header">
                <div class="card-header-left">
                  <span class="material-symbols-outlined text-danger" aria-hidden="true">gavel</span>
                  <h2 class="card-heading">Protokol Integritas & Konsekuensi Pelanggaran</h2>
                </div>
                <span class="status-badge badge-warning">Wajib Dipatuhi</span>
              </div>

              <div class="penalty-alert-banner">
                <span class="material-symbols-outlined penalty-icon" aria-hidden="true">warning</span>
                <div>
                  <strong>PERINGATAN DISKUALIFIKASI (NILAI 0):</strong>
                  <p>
                    Sistem mendeteksi setiap perpindahan tab browser atau aplikasi lain. Toleransi maksimal adalah
                    <strong>3 kali perpindahan</strong>. Jika Anda berpindah tab untuk yang ke-4 kalinya, sesi ujian
                    otomatis ditutup, dinyatakan <strong>DISKUALIFIKASI</strong>, dan <strong>NILAI OTOMATIS 0</strong>.
                  </p>
                </div>
              </div>

              <ul class="exam-rules-list">
                <li>
                  <span class="material-symbols-outlined rule-ico" aria-hidden="true">videocam</span>
                  <div>
                    <strong>Kamera Web Pengawas Wajib Terus Menyala</strong>
                    <span>Wajah asesi harus selalu terlihat jelas di layar selama pengerjaan soal.</span>
                  </div>
                </li>
                <li>
                  <span class="material-symbols-outlined rule-ico" aria-hidden="true">tab_unselected</span>
                  <div>
                    <strong>Batas Pindah Tab Browser: Maksimal 3 Kali</strong>
                    <span>Membuka tab baru, jendela lain, atau berpindah aplikasi dicatat sebagai pelanggaran
                      integritas.</span>
                  </div>
                </li>
                <li>
                  <span class="material-symbols-outlined rule-ico" aria-hidden="true">fullscreen</span>
                  <div>
                    <strong>Wajib Berjalan pada Mode Layar Penuh (Fullscreen)</strong>
                    <span>Keluar dari layar penuh akan memicu verifikasi ulang oleh sistem proktor.</span>
                  </div>
                </li>
                <li>
                  <span class="material-symbols-outlined rule-ico" aria-hidden="true">block</span>
                  <div>
                    <strong>Pencegahan Salin Teks (Anti Copy-Paste)</strong>
                    <span>Klik kanan, pintasan keyboard salin-tempel, dan screenshot dinonaktifkan di halaman
                      ujian.</span>
                  </div>
                </li>
              </ul>
            </div>

            <!-- Right: Camera Verification & Readiness Card -->
            <div class="card exam-camera-check-card">
              <div class="card-header">
                <div class="card-header-left">
                  <span class="material-symbols-outlined text-primary" aria-hidden="true">photo_camera</span>
                  <h2 class="card-heading">Uji Perangkat Kamera Asesi</h2>
                </div>
                <span id="lobby-cam-badge" class="status-badge badge-warning">Pemeriksaan Lensa</span>
              </div>

              <!-- Camera Feed Viewport in Lobby -->
              <div class="cam-preview-box">
                <video id="lobby-video-preview" autoplay playsinline muted></video>
                <div id="lobby-cam-placeholder" class="cam-placeholder-overlay">
                  <span class="material-symbols-outlined" aria-hidden="true">videocam</span>
                  <p>Kamera belum aktif. Klik tombol aktifkan di bawah untuk memulai pratinjau wajah Anda.</p>
                </div>
                <div class="cam-ai-tracker-box">
                  <div class="ai-reticle"></div>
                  <span class="ai-status-tag">AI Deteksi Wajah: Siap</span>
                </div>
              </div>

              <div class="cam-actions-row">
                <button type="button" class="btn btn-outline btn-sm btn-block" id="btn-request-webcam">
                  <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">videocam</span>
                  Aktifkan & Uji Kamera Saya
                </button>
              </div>

              <!-- Candidate Info Checklist -->
              <div class="candidate-check-meta font-mono text-xs">
                <div>Skema Uji : SKM-BNSP-CSO-26 (Auditor Forensik Digital)</div>
                <div>Asesi : Raden Bagus Prakoso, S.Kom</div>
                <div>Passing Grade : Minimal 80 Poin (Nilai >= 80 Lolos, < 80 Gagal)</div>
                    <div>Durasi Uji : 15 Menit (5 Butir Soal Terstandar SKKNI)</div>
                </div>

                <button type="button" class="btn btn-primary btn-block btn-lg mt-3" id="btn-start-active-exam">
                  <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">play_arrow</span>
                  Mulai Sesi Ujian Berproktor Ketat
                </button>
              </div>

            </div>
          </div>

          <!-- View State B: Active Examination Workspace (Strict Mode) -->
          <div id="exam-active-screen" class="exam-screen-block" style="display:none;">

            <!-- Exam Sticky Top Bar with Strict Anti-Cheat Indicators -->
            <div class="exam-proctor-topbar">
              <div class="proctor-bar-left">
                <div class="exam-live-indicator">
                  <span class="pulse-red-dot" aria-hidden="true"></span>
                  <strong>SESI UJIAN BERPROKTOR AKTIF</strong>
                </div>
                <span class="exam-scheme-tag font-mono">SKM-BNSP-CSO-26</span>
              </div>

              <!-- Strike Violations Counter (Max 3 Times) -->
              <div class="proctor-bar-center">
                <div class="violation-tracker-widget" id="violation-tracker-box">
                  <div class="violation-title-row">
                    <span class="material-symbols-outlined text-warning" aria-hidden="true">warning</span>
                    <span>Pelanggaran Pindah Tab:</span>
                    <strong id="violation-count-text" class="font-mono text-danger">0 / 3 Kali</strong>
                  </div>
                  <div class="violation-indicators-track">
                    <span class="strike-dot" id="strike-dot-1" title="Toleransi 1"></span>
                    <span class="strike-dot" id="strike-dot-2" title="Toleransi 2"></span>
                    <span class="strike-dot" id="strike-dot-3" title="Toleransi 3"></span>
                    <span class="strike-dot strike-danger" id="strike-dot-4" title="Diskualifikasi (Nilai 0)"></span>
                  </div>
                </div>
              </div>

              <!-- Countdown Timer & Actions -->
              <div class="proctor-bar-right">
                <div class="timer-countdown-box">
                  <span class="material-symbols-outlined" aria-hidden="true">timer</span>
                  <span id="exam-timer-display" class="font-mono timer-value">15:00</span>
                </div>
                <button type="button" class="btn btn-outline btn-sm" id="btn-toggle-fullscreen" title="Layar Penuh">
                  <span class="material-symbols-outlined" aria-hidden="true">fullscreen</span>
                </button>
              </div>
            </div>

            <!-- Exam Main Grid: Questions & Proctoring Sidebar -->
            <div class="exam-workspace-grid">

              <!-- Left: Question Viewport -->
              <div class="card exam-question-card" id="exam-question-container">

                <div class="question-header-row">
                  <div class="q-number-badge">
                    Soal No. <span id="current-q-index">1</span> dari <span id="total-q-count">5</span>
                  </div>
                  <div class="q-actions-quick">
                    <button type="button" class="btn btn-outline btn-sm" id="btn-flag-doubt">
                      <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">bookmark</span>
                      <span id="flag-doubt-text">Tandai Ragu-ragu</span>
                    </button>
                  </div>
                </div>

                <!-- Question Text & SKKNI Code Reference -->
                <div class="question-body">
                  <span class="q-unit-code font-mono" id="q-unit-ref">Unit: J.622000.001.01</span>
                  <h2 class="q-prompt" id="q-prompt-text">
                    Memuat butir pertanyaan asesmen kompetensi...
                  </h2>

                  <!-- Multiple Choice Options -->
                  <div class="options-container" id="options-list-container" role="radiogroup"
                    aria-labelledby="q-prompt-text">
                    <!-- Injected via JavaScript -->
                  </div>
                </div>

                <!-- Navigation Controls -->
                <div class="question-footer-nav">
                  <button type="button" class="btn btn-outline" id="btn-prev-question">
                    <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">arrow_back</span>
                    Soal Sebelumnya
                  </button>
                  <div class="footer-center-note text-xs text-subtle font-mono">
                    Jawaban otomatis tersimpan pada server LSP
                  </div>
                  <button type="button" class="btn btn-primary" id="btn-next-question">
                    Soal Berikutnya
                    <span class="material-symbols-outlined btn-icon-end" aria-hidden="true">arrow_forward</span>
                  </button>
                </div>

              </div>

              <!-- Right Sidebar: Camera Feed & Question Navigator -->
              <div class="exam-sidebar-proctor">

                <!-- Live Video Feed Box -->
                <div class="card proctor-video-card">
                  <div class="proctor-video-header">
                    <span class="live-rec-badge">
                      <span class="rec-dot"></span>
                      REC LIVE
                    </span>
                    <span class="font-mono text-xs">AI Face Monitor</span>
                  </div>
                  <div class="proctor-stream-box">
                    <video id="active-exam-video" autoplay playsinline muted></video>
                    <div class="ai-stream-overlay">
                      <div class="face-target-box"></div>
                      <span class="face-status-text">Status: 1 Wajah Terdeteksi</span>
                    </div>
                  </div>
                  <div class="proctor-stream-footer">
                    <span class="text-xs text-subtle">Asesor Pemantau: <strong>Aktif</strong></span>
                    <span class="material-symbols-outlined text-success" style="font-size:1.1rem;"
                      aria-hidden="true">check_circle</span>
                  </div>
                </div>

                <!-- Question Navigator Palette -->
                <div class="card exam-palette-card">
                  <h3 class="palette-title">Navigasi Nomor Soal</h3>
                  <div class="palette-grid" id="question-nav-palette">
                    <!-- Injected dynamically: buttons 1 to 5 -->
                  </div>

                  <div class="palette-legend">
                    <div class="legend-item"><span class="legend-swatch answered"></span> Dijawab</div>
                    <div class="legend-item"><span class="legend-swatch doubtful"></span> Ragu-ragu</div>
                    <div class="legend-item"><span class="legend-swatch unanswered"></span> Belum</div>
                  </div>

                  <button type="button" class="btn btn-danger btn-block mt-3" id="btn-finish-exam-trigger">
                    <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">task_alt</span>
                    Selesaikan Ujian Sekarang
                  </button>
                </div>

              </div>

            </div>
          </div>

          <!-- View State C: Exam Result Screen (Normal Completion OR Disqualification Score 0) -->
          <div id="exam-result-screen" class="exam-screen-block" style="display:none;">
            <div class="exam-result-container" id="exam-result-card-wrap">
              <!-- Dynamically populated by app.js (Normal Score or Disqualification Nilai 0) -->
            </div>
          </div>

        </div>
    </section>

    <!-- Strict Tab Violation Alert Modal (Triggers on each tab switch) -->
    <div id="tab-violation-modal" class="modal-overlay violation-modal-overlay" role="alertdialog" aria-modal="true"
      aria-labelledby="violation-modal-title" aria-hidden="true">
      <div class="modal-card violation-card">
        <div class="violation-modal-header">
          <div class="siren-icon-wrap">
            <span class="material-symbols-outlined siren-icon" aria-hidden="true">warning</span>
          </div>
          <div>
            <h2 id="violation-modal-title" class="violation-header-title">PERINGATAN PELANGGARAN INTEGRITAS!</h2>
            <span class="violation-header-sub">Terdeteksi Aktivitas Berpindah Tab atau Aplikasi</span>
          </div>
        </div>

        <div class="modal-body violation-body">
          <div class="violation-count-highlight">
            <span class="v-label">Jumlah Pelanggaran Anda Saat Ini:</span>
            <div class="v-numbers font-mono" id="modal-violation-stat">
              <span id="modal-current-strikes">1</span> dari 3 Kali Batas Toleransi
            </div>
          </div>

          <div class="violation-explain-box">
            <p>
              Anda terdeteksi meninggalkan jendela ujian aktif. Sistem CBT BNSP mencatat stempel waktu kejadian ini
              secara otomatis ke dalam log berita acara pengawasan.
            </p>
            <div class="penalty-warning-text">
              <span class="material-symbols-outlined" aria-hidden="true">gavel</span>
              <strong>Perhatian Keras:</strong> Jika pelanggaran mencapai 4 kali, sesi Anda akan langsung dihentikan dan
              <strong>NILAI OTOMATIS 0 (DISKUALIFIKASI)</strong>.
            </div>
          </div>
        </div>

        <div class="modal-footer violation-footer">
          <button type="button" class="btn btn-danger btn-block btn-lg" id="btn-ack-violation">
            <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">verified_user</span>
            Saya Mengerti dan Kembali Mengerjakan Ujian
          </button>
        </div>
      </div>
    </div>

    <!-- Confirmation Modal: Selesaikan Ujian -->
    <div id="confirm-finish-modal" class="modal-overlay" role="dialog" aria-modal="true"
      aria-labelledby="finish-modal-title" aria-hidden="true">
      <div class="modal-card">
        <div class="modal-header">
          <div class="modal-title-wrap">
            <span class="material-symbols-outlined text-primary" aria-hidden="true">help</span>
            <h2 id="finish-modal-title" class="modal-title">Konfirmasi Penyelesaian Ujian</h2>
          </div>
          <button type="button" id="close-finish-modal-btn" class="modal-close-btn btn-icon" aria-label="Batal">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
          </button>
        </div>
        <div class="modal-body">
          <p class="text-sm text-muted mb-3">
            Apakah Anda yakin ingin mengakhiri sesi ujian online ini? Pastikan seluruh butir soal telah diperiksa dengan
            seksama.
          </p>
          <div class="confirm-summary-box font-mono text-sm" id="finish-summary-stats">
            <div>Total Soal : 5 Butir</div>
            <div>Terjawab : <span id="summary-answered-count">0</span> Butir</div>
            <div>Ragu-ragu : <span id="summary-doubt-count">0</span> Butir</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" id="btn-cancel-finish">Kembali Memeriksa</button>
          <button type="button" class="btn btn-primary" id="btn-confirm-submit-exam">
            <span class="material-symbols-outlined btn-icon-start" aria-hidden="true">check</span>
            Kirim Jawaban & Lihat Hasil
          </button>
        </div>
      </div>
    </div>

